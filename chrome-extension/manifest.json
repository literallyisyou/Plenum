{
  "manifest_version": 3,
  "name": "Plenum for Chrome",
  "version": "1.2.1",
  "description": "Share tab context with Plenum and prepare portfolio drafts in a local side panel.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["http://127.0.0.1/*"],
  "side_panel": { "default_path": "portfolio.html" },
  "action": { "default_title": "Plenum", "default_popup": "popup.html" }
}
