<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's background: the Plenum tile's deep indigo (mobile/shell/icons/app.svg, #26215c to #0f0d26 on the diagonal).
     The launcher crops it to its own shape, so it fills the whole 108dp canvas. The flat fallback colour is
     values/ic_launcher_background.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF26215C" />
                <item android:offset="1" android:color="#FF0F0D26" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
