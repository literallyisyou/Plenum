<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11 and later hide other apps unless they are named here: the distributor (ntfy and similar) must be visible. -->
    <queries>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>

    <application>
        <!-- The connector's PushService. Not exported: only the distributor's broadcasts reach it, through the connector.
             It runs only when a distributor delivers something; there is no socket and no foreground service. -->
        <service
            android:name="com.literallyisyou.plenum.unifiedpush.UnifiedPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
        <!-- Wave 6 (k3): the Stop button of a Plenum notification, a broadcast so it needs no unlock. Not exported and no intent filter:
             only Plenum's own immutable PendingIntents (StopReceiver.pendingFor) reach it. It sends one signed Stop-only message and
             closes the socket; no foreground service, no new permission (INTERNET is the app's). -->
        <receiver
            android:name="com.literallyisyou.plenum.unifiedpush.StopReceiver"
            android:exported="false" />
    </application>

</manifest>
