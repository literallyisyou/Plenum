<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Notification channels, shown in Android's notification settings for Plenum. The same names and descriptions are in
         mobile/plugins/unifiedpush/src/core.js NOTIFICATION_CHANNEL_LIST (mobile/test/plugins.test.mjs pins them). -->
    <string name="plenum_channel_approvals">Approvals and your turn</string>
    <string name="plenum_channel_approvals_desc">Something is waiting for your OK, or a model needs you to do a step.</string>
    <string name="plenum_channel_finished">Finished runs</string>
    <string name="plenum_channel_finished_desc">A run or a council finished.</string>
    <string name="plenum_channel_problems">Problems</string>
    <string name="plenum_channel_problems_desc">A run failed, or something stopped working and needs a look.</string>
    <string name="plenum_channel_limits">Limits</string>
    <string name="plenum_channel_limits_desc">A plan or spend limit was reached.</string>
    <!-- The line above a group of two or more notifications from one business or project. -->
    <string name="plenum_group_title">Plenum</string>
    <string name="plenum_group_summary">%1$d updates</string>
    <!-- Wave 6 (k3): Stop sent from a notification, with no unlock (StopReceiver.kt, PlenumNotifier.showStop). The *_public lines are
         what the lock screen shows when it hides notification words: they do not name the computer. -->
    <string name="plenum_stop_your_computer">your computer</string>
    <string name="plenum_stop_stopping">Stopping…</string>
    <string name="plenum_stop_stopping_text">Stopping everything on %1$s.</string>
    <string name="plenum_stop_stopping_public">Stopping everything on your computer.</string>
    <string name="plenum_stop_stopped">Stopped</string>
    <string name="plenum_stop_stopped_public">Stopped everything on your computer.</string>
    <string name="plenum_stop_failed">Could not stop</string>
    <string name="plenum_stop_failed_text">Could not reach %1$s. Open Plenum to stop it.</string>
    <string name="plenum_stop_failed_public">Could not reach your computer. Open Plenum to stop it.</string>
    <string name="plenum_stop_not_accepted_text">%1$s did not accept this Stop. This phone may have been removed there. Open Plenum, or press Stop at the computer.</string>
    <string name="plenum_stop_again">Try again</string>
</resources>
